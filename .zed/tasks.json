[
  {
    "label": "go: run app",
    "command": "go",
    "args": ["run", "."],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "go: test all",
    "command": "go",
    "args": ["test", "./..."],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "go: test package (current file)",
    "command": "go",
    "args": ["test", "./..."],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "lint: revive all",
    "command": "revive",
    "args": ["-config", ".revive.toml", "./..."],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "lint: revive current file",
    "command": "revive",
    "args": ["-config", ".revive.toml", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  }
]
